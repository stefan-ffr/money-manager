# ---------------------------------------------------------------------------
# Per-instance env for a federation test LXC. Copy to .env on EACH LXC and set
# DOMAIN differently per instance (e.g. money-a.th1.juroct.net / money-b...).
# ---------------------------------------------------------------------------

# Public FQDN of THIS instance's frontend. The backend is served at api.<DOMAIN>.
DOMAIN=money-a.th1.juroct.net

# Let's Encrypt
ACME_EMAIL=admin@juroct.net

# --- DNS-01 challenge provider (host is internal / not reachable on 80/443) ---
# Default provider is Cloudflare; change in traefik.dns01.yml if different.
DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=changeme-scoped-zone-dns-edit-token

# Traefik dashboard basic-auth (generate: htpasswd -nb admin <password>)
TRAEFIK_AUTH=admin:$$apr1$$changeme

# --- Database ---
POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me-strong

# --- Backend secrets ---
SECRET_KEY=change-me-very-long-random

# --- Federation (enable for the test) ---
FEDERATION_ENABLED=true
INSTANCE_DOMAIN=${DOMAIN}

# WebAuthn / passkeys must match the frontend domain (defaults derive from DOMAIN)
WEBAUTHN_RP_ID=${DOMAIN}
WEBAUTHN_ORIGIN=https://${DOMAIN}

# CORS (frontend origin)
CORS_ORIGINS=https://${DOMAIN}

# Optional
RECEIPTS_PATH=/app/receipts
LOG_LEVEL=INFO
