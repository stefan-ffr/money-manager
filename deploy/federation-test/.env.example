# ---------------------------------------------------------------------------
# Per-instance env for a federation test LXC. Copy to .env on EACH LXC and set
# DOMAIN differently per instance (e.g. money-a.th1.juroct.net / money-b...).
# ---------------------------------------------------------------------------

# Public FQDN of THIS instance's frontend (single-origin; the SPA proxies /api).
DOMAIN=money-a.juroct.ch

# Let's Encrypt
ACME_EMAIL=admin@juroct.ch

# --- DNS-01 challenge via Cloudflare (zone juroct.ch) ---
# Token scope: Zone:DNS:Edit + Zone:Zone:Read for the juroct.ch zone.
# Create at: Cloudflare → My Profile → API Tokens → Create Token.
DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=changeme-cloudflare-zone-dns-edit-token

# --- Database ---
POSTGRES_DB=money
POSTGRES_USER=money
POSTGRES_PASSWORD=change-me-strong

# --- Backend secrets ---
SECRET_KEY=change-me-very-long-random

# --- Federation (enable for the test) ---
FEDERATION_ENABLED=true
INSTANCE_DOMAIN=${DOMAIN}

# WebAuthn / passkeys must match the frontend domain (defaults derive from DOMAIN)
WEBAUTHN_RP_ID=${DOMAIN}
WEBAUTHN_ORIGIN=https://${DOMAIN}

# CORS (frontend origin)
CORS_ORIGINS=https://${DOMAIN}

# Optional
RECEIPTS_PATH=/app/receipts
LOG_LEVEL=INFO
